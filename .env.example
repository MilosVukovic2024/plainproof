# Postgres connection. On Vercel: Storage → Create Database → Neon sets this for you.
DATABASE_URL=

# Claude API key from platform.claude.com → API keys.
ANTHROPIC_API_KEY=

# A long random password (40+ characters). It is also the editor key for /review.
# Vercel Cron sends it automatically; the pipeline uses it to call itself.
CRON_SECRET=

# Citizen attachments: Vercel → Storage → Create → Blob (private). Sets this for you.
BLOB_READ_WRITE_TOKEN=

# Paid own addresses (name.plainproof.me) through Paddle. Leave empty to hide the offer.
# Client-side token (test_… for sandbox, live_… for live), the price id (pri_…) of the
# product, and the secret of the notification destination pointing at /api/paddle.
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# MAX_REPORTS_PER_DAY=30
# ROOT_DOMAIN=plainproof.me
