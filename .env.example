# Postgres connection. On Vercel: Storage → Create Database → Neon sets this for you.
DATABASE_URL=

# Claude API key from platform.claude.com → API keys.
ANTHROPIC_API_KEY=

# A long random password (40+ characters). It is also the editor key for /review.
# Vercel Cron sends it automatically; the pipeline uses it to call itself.
CRON_SECRET=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# MAX_REPORTS_PER_DAY=30
